---
import Button from "./button.astro";
---

<h1><span class="status-badge"></span> Pugal Available For Hire</h1>
<div class="hero-content">
  <h2>Architecting <span>Scalable</span> Systems.</h2>
  <h2>Engineering Workflow <span>Superpowers</span>.</h2>
</div>
<p class="hero-description">
  I am Pugalendhi Vanangamudi—a Design System Architect, UI/UX Developer, and
  Figma Plugin Creator with 10+ years of battle-tested experience. I forge
  enterprise-grade design systems, engineer high-performance web apps, and build
  custom Figma plugins that eliminate chaos and accelerate teams to lightspeed.
</p>

<style lang="scss" is:global>
  @use "../../public/sass/variables" as *;
  @use "../../public/sass/mixin" as *;
  @use "../../public/sass/root" as *;

  h1 {
    padding: 0.5rem 1rem;
    border: 1px solid var(--primary-color);
    background-color: var(--card-bg-color);
    border-radius: var(--rd-32);
    font-size: var(--font-12);
    font-weight: var(--regularFont);
    color: var(--primary-color);
    @include flex-element;
    gap: 0.5rem;
    align-items: center;

    .status-badge {
      width: 0.5rem;
      height: 0.5rem;
      background-color: var(--green-color);
      border-radius: 50%;
      display: inline-block;
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0% {
        outline: 0px solid var(--green-color);
      }

      100% {
        outline: 0.25rem solid var(--green-color-16);
      }
    }
  }

  .hero-content,
  .hero-description {
    text-align: center;

    h2 {
      font-size: var(--font-40);
      font-family: var(--headingFont);
      color: var(--text-color);
      margin-bottom: 1rem;

      span {
        color: var(--primary-color);
        font-family: var(--specialFont);
      }
    }
  }

  .hero-description {
    width: 60%;
  }

  .action-wrapper {
    @include flex-element;
    justify-content: center;
    gap: 1rem;
  }

  @media screen and (max-width: 40rem) {
    .action-wrapper {
      align-items: center;
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
