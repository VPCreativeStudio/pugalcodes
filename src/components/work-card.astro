---
interface Props {
  title: string;
  heading: string;
  description: string;
  link: URL;
}

const { title, heading, description, link } = Astro.props;
---

<div class="work-card">
  <div class="work-title">
    <h4>{title}</h4>
    <a href={link} target="_blank">
      <i class="icon external-link"></i>
    </a>
  </div>
  <h5>{heading}</h5>
  <p>{description}</p>
</div>

<style lang="scss" is:global>
  @use "../../public/sass/variables" as *;
  @use "../../public/sass/mixin" as *;
  @use "../../public/sass/root" as *;
</style>
