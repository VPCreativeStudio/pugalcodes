---
import NavItem from "./nav-item.astro";
---

<nav role="navigation">
  <ul class="nav-list" role="list">
    <li class="nav-item" role="listitem"><NavItem label="MANIFESTO" /></li>
    <li class="nav-item" role="listitem"><NavItem label="CORE TECH" /></li>
    <li class="nav-item" role="listitem"><NavItem label="WORKS" /></li>
  </ul>
</nav>

<style lang="scss" is:global>
  @use "../../public/sass/variables" as *;
  @use "../../public/sass/mixin" as *;
  @use "../../public/sass/root" as *;

  nav {
    .nav-list {
      @include flex-element;
      gap: 1rem;
      list-style: none;
      padding: 0;
      margin: 0;

      .nav-item {
        @include rel-position;
        @include flex-element;
        align-items: center;
        padding: 0.5rem 1rem;
        color: var(--text-color);
        cursor: pointer;

        .nav-link {
          font-size: var(--font-14);
          text-decoration: none;
          transition: all 0.3s ease;
        }

        &::before,
        &::after {
          transition: width 0.3s ease;
          opacity: 0;
        }

        &::before {
          content: "[";
        }
        &::after {
          content: "]";
        }

        &:hover {
          color: var(--primary-color);

          &::before,
          &::after {
            opacity: 1;
          }

          &::before {
            transform: translateX(-0.5rem);
          }
          &::after {
            transform: translateX(0.5rem);
          }
        }
      }
    }
  }
</style>
